# Pharmacy Stock Auditing System — backend environment template (committed)
# Copy to backend/.env (which is git-ignored), replace every CHANGE_ME value,
# and never commit the filled-in file.

DATABASE_URL=postgresql+psycopg://pharmacy:CHANGE_ME@127.0.0.1:54329/pharmacy
DATABASE_URL_TEST=postgresql+psycopg://pharmacy:CHANGE_ME@127.0.0.1:54329/pharmacy_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_secrets_token_urlsafe_48

ENVIRONMENT=development
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15

LOCAL_TIMEZONE=Africa/Dar_es_Salaam

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
