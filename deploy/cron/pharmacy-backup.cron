# Nightly PostgreSQL backup + weekly restore verification.
# NOT INSTALLED. Installation requires separate approval.
# Check current jobs first: crontab -l
# Back up current crontab before replacing it.
# Times are host local time.
# Backups and database are on the same disk; off-site upload is configured
# through the private wrapper config at ~/.config/pharmacy-backup/env.

SHELL=/bin/bash
PATH=/home/Salva508/.local/bin:/usr/local/bin:/usr/bin:/bin

# 02:17 — validated nightly backup, encrypted off-site upload, private log.
17 2 * * * cd /home/Salva508/Projects/pharmacy-stock-audit && /bin/bash -c 'umask 077; mkdir -p backups/logs && chmod 700 backups/logs && exec scripts/nightly-backup-cron.sh >> backups/logs/cron.log 2>&1'

# 03:17 Sunday — restore newest nightly dump into a disposable database.
17 3 * * 0 cd /home/Salva508/Projects/pharmacy-stock-audit && /bin/bash -c 'umask 077; mkdir -p backups/logs && chmod 700 backups/logs && exec scripts/verify-backup.sh --latest-nightly >> backups/logs/verify-cron.log 2>&1'
